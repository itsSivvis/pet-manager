{
  "name": "pet-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted pet care manager: health records, medications, appointments, feeding and reminders.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "npm run i18n:check && npm run test --workspace server && npm run test --workspace client",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "db:migrate": "npm run migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "screenshots": "node scripts/screenshots.mjs",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "~1.56.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "license-checker-rseidelsohn": "^4.4.0",
    "prettier": "^3.6.0"
  }
}
