# Pet Manager configuration. Copy to .env and adjust.
# Lines starting with # are comments. Never commit your real .env file.

# --- Required in production ---------------------------------------------------

# Secret used to sign login tokens. At least 32 random characters.
# Generate one with:  openssl rand -hex 32
# The server refuses to start in production without it.
JWT_SECRET=

# PostgreSQL password (used by docker-compose.yml for the db container and the app).
POSTGRES_PASSWORD=

# Public URL(s) of the web app, comma separated. Used for CORS. Only needed if
# the client is served from a different origin than the API (e.g. dev server).
# Example: https://pets.example.com
CLIENT_URL=

# --- Database -----------------------------------------------------------------

# Used when running the server outside of docker-compose.
# DATABASE_URL=postgres://petmanager:petmanager@localhost:5432/petmanager
# POSTGRES_USER=petmanager
# POSTGRES_DB=petmanager

# --- Server -------------------------------------------------------------------

# Port the server listens on inside the container / on the host.
# PORT=3000
# Host port published by docker-compose.yml (bound to 127.0.0.1).
# APP_PORT=3000

# Timezone for reminders and "today" (IANA name, e.g. Europe/Berlin, America/New_York).
TZ=UTC

# Language of push notifications if not set in the admin area: en or de.
# DEFAULT_LOCALE=en

# Number of reverse proxies in front of the app (needed for correct client IPs
# in rate limiting). 1 if you use Caddy/nginx/Traefik, 0 if exposed directly.
TRUST_PROXY=1

# How long a login stays valid (e.g. 7d, 12h).
# JWT_EXPIRES_IN=7d

# Max. failed login/registration attempts per IP and 15 minutes.
# AUTH_RATE_LIMIT=10

# --- Uploads ------------------------------------------------------------------

# Where pet photos are stored. Back this directory up together with the database.
# UPLOAD_DIR=/data/uploads
# Max. photo size in MB.
# MAX_UPLOAD_MB=5

# --- Reminders ----------------------------------------------------------------

# Set to false to disable the reminder scheduler (e.g. on a second replica).
# REMINDERS_ENABLED=true
# How often reminders are checked, in seconds.
# REMINDER_INTERVAL_SECONDS=60
# ntfy server, topic and token are configured in the web UI (Administration).

# --- Security switches --------------------------------------------------------

# DANGER: allows an admin to switch off the login requirement in the UI. Then
# EVERYONE who can reach the instance can read and change all data without an
# account. Only for trusted private networks. Never on the internet.
ALLOW_ANONYMOUS_MODE=false

# Docker image to run (docker-compose.yml).
# PET_MANAGER_IMAGE=ghcr.io/OWNER/pet-manager:latest
